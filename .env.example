# =============================================================================
# 🔐 BACKEND SERVERLESS SECRETS (SERVER-SIDE ONLY - VERCEL / NODE.JS)
# STRICT RULE: NEVER prefix these with VITE_
# Vite automatically inlines any VITE_* variable into public client JS bundles.
# =============================================================================
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Neon Serverless PostgreSQL Database
DATABASE_URL="postgresql://user:password@ep-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
NEON_DATABASE_URL="postgresql://user:password@ep-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Distributed Upstash Redis (Edge Rate Limiting & Load Balancing)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Clerk Enterprise JWT Authentication Verification
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWT_KEY=your_clerk_pem_public_key_or_jwks

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Transactional Email (Resend & Gmail SMTP)
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL="Bedrock <onboarding@resend.dev>"
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_app_password"

# =============================================================================
# 🌐 PUBLIC CLIENT-SIDE VARIABLES (SAFE TO EXPOSE TO BROWSER)
# Only variables with the VITE_ prefix are exposed to the client application.
# =============================================================================
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
VITE_POSTHOG_PROJECT_TOKEN=phc_placeholder
VITE_POSTHOG_HOST=https://us.i.posthog.com

