{
  "name": "bedrock-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Bedrock Prompt Engineering App",
  "author": "Bedrock Inc",
  "type": "module",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.bedrock.desktop",
    "productName": "Bedrock",
