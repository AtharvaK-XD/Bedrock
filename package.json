    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@types/three": "^0.185.4",
    "@xyflow/react": "^12.11.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^10.1.0",
