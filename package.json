{
  "name": "bedrock-desktop",
  "private": true,
  "version": "1.2.4",
  "description": "Bedrock Prompt Engineering App",
  "author": "Bedrock Inc",
  "type": "module",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.bedrock.desktop",
    "productName": "Bedrock",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Bedrockxai",
        "repo": "Bedrock",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Bedrock Protocol",
        "schemes": [
          "bedrock"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Bedrock",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bedrock"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "src-tauri/icons/icon.icns",
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:pack": "npm run build && electron-builder --dir",
    "tauri": "tauri",
    "lint": "oxlint",
    "preview": "vite preview",
    "scan:secrets": "node scripts/scan-secrets.js",
    "test:injection": "cd server && npx tsx tests/prompt-injection-runner.ts",
    "test:attacks": "cd server && npx tsx tests/security-attack-suite.ts",
    "test:k6:ratelimit": "node scripts/run-k6.js run tests/k6-rate-limit-test.js",
    "test:k6:load": "node scripts/run-k6.js run tests/k6-load-balancing-test.js",
    "test:k6:wizard": "node scripts/run-k6.js run tests/k6-wizard-load-test.js",
    "video": "remotion studio remotion/index.ts",
    "video:render": "remotion render remotion/index.ts BedrockStartupIntro public/bedrock-intro.mp4",
    "video:render:4k": "remotion render remotion/index.ts BedrockStartupIntro4K public/bedrock-intro-4k.mp4",
    "video:still": "remotion still remotion/index.ts BedrockStartupIntro public/bedrock-intro-poster.jpg --frame=700"
  },
  "dependencies": {
    "@clerk/react": "^6.17.0",
    "@hookform/resolvers": "^5.7.1",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@neondatabase/serverless": "^1.1.0",
    "@posthog/react": "^1.11.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@sentry/react": "^11.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@types/three": "^0.185.4",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/node": "^16.0.2",
    "@xyflow/react": "^12.11.3",
    "border-beam": "^1.3.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "langfuse": "^3.39.2",
    "lenis": "^1.3.25",
    "lucide-react": "^1.28.0",
    "motion": "^14.0.0",
    "nodemailer": "^10.0.15",
    "posthog-js": "^1.434.17",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.2",
    "resend": "^6.32.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@remotion/cli": "^4.0.534",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "bestzip": "^3.0.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.25",
    "remotion": "^4.0.534",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
